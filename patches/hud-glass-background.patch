+/* Glass plate behind the capsule: the pill used to sit bare on the wallpaper.
+   A dark aurora gradient + frosted backdrop gives it a real "card" background
+   that stays readable on white or busy wallpapers alike. */
+@interface HUDGlassBackgroundView : UIView
+
+@property (nonatomic, assign) CGFloat pillCornerRadius;
+
+@end
+
+@implementation HUDGlassBackgroundView {
+    CAGradientLayer *_baseGradient;
+    CAGradientLayer *_auroraGlow;
+    CAShapeLayer *_borderLayer;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+    self = [super initWithFrame:frame];
+    if (self) {
+        self.opaque = NO;
+        self.backgroundColor = [UIColor clearColor];
+        self.userInteractionEnabled = NO;
+        self.clipsToBounds = YES;
+        self.layer.cornerRadius = HUD_MIN_CORNER_RADIUS;
+        self.layer.masksToBounds = YES;
+        self.pillCornerRadius = HUD_MIN_CORNER_RADIUS;
+
+        _baseGradient = [CAGradientLayer layer];
+        _baseGradient.colors = @[
+            (id)[UIColor colorWithRed:0.17 green:0.31 blue:0.52 alpha:0.74].CGColor,
+            (id)[UIColor colorWithRed:0.07 green:0.13 blue:0.23 alpha:0.84].CGColor,
+            (id)[UIColor colorWithRed:0.03 green:0.05 blue:0.10 alpha:0.92].CGColor,
+        ];
+        _baseGradient.locations = @[ @0.0, @0.55, @1.0 ];
+        _baseGradient.startPoint = CGPointMake(0.0, 0.0);
+        _baseGradient.endPoint = CGPointMake(0.55, 1.0);
+        [self.layer addSublayer:_baseGradient];
+
+        _auroraGlow = [CAGradientLayer layer];
+        _auroraGlow.colors = @[
+            (id)[UIColor colorWithRed:0.20 green:0.60 blue:1.0 alpha:0.30].CGColor,
+            (id)[UIColor colorWithRed:0.28 green:0.84 blue:0.96 alpha:0.08].CGColor,
+            (id)[UIColor clearColor].CGColor,
+        ];
+        _auroraGlow.locations = @[ @0.0, @0.42, @1.0 ];
+        _auroraGlow.startPoint = CGPointMake(0.0, 0.0);
+        _auroraGlow.endPoint = CGPointMake(1.0, 1.0);
+        [self.layer addSublayer:_auroraGlow];
+
+        _borderLayer = [CAShapeLayer layer];
+        _borderLayer.fillColor = nil;
+        _borderLayer.strokeColor = [UIColor colorWithWhite:1.0 alpha:0.16].CGColor;
+        _borderLayer.lineWidth = 1.0;
+        [self.layer addSublayer:_borderLayer];
+    }
+    return self;
+}
+
+- (void)setPillCornerRadius:(CGFloat)pillCornerRadius
+{
+    _pillCornerRadius = pillCornerRadius;
+    self.layer.cornerRadius = pillCornerRadius;
+    [self setNeedsLayout];
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+
+    CGRect bounds = self.bounds;
+    _baseGradient.frame = bounds;
+    _auroraGlow.frame = bounds;
+
+    CGFloat radius = MAX(self.layer.cornerRadius - 0.5, 0.0);
+    _borderLayer.frame = bounds;
+    _borderLayer.path = [UIBezierPath bezierPathWithRoundedRect:CGRectInset(bounds, 0.5, 0.5)
+                                                 cornerRadius:radius].CGPath;
+}
+
+@end
+
